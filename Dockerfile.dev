# Local dev image — mounts source and runs Vite dev server with HMR.
FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache libc6-compat git && corepack enable && npm install -g bun@1.4.4 --registry=https://registry.npmjs.org
ENV NODE_ENV=development \
    HOST=0.0.0.0 \
    PORT=8080
EXPOSE 8080
CMD ["sh","-c","bun install --frozen-lockfile && npm run dev -- --host 0.0.0.0 --port 8080"]
