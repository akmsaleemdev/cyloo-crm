# Copy to .env and fill in. Never commit the real file.
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# Must match the CYLOO project secrets of the same name.
WA_QR_WORKER_TOKEN=
WA_QR_WORKER_SIGNING_SECRET=
WA_QR_WEBHOOK_SECRET=

# CYLOO webhook endpoint the worker posts events to.
CYLOO_WEBHOOK_URL=https://cyloo.ai/api/public/whatsapp/qr-webhook

# Persistent Baileys credential storage (must survive restarts).
WA_AUTH_DIR=./data/auth
